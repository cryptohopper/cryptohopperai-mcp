{
  "name": "cryptohopperai-mcp",
  "version": "0.1.0-alpha.1",
  "description": "MCP server for the Cryptohopper.AI API — let Claude Desktop, Cursor, and other LLM hosts build & refine Cryptohopper.AI crypto projects",
  "type": "module",
  "bin": {
    "cryptohopper-mcp": "./dist/index.js"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "start": "node ./dist/index.js",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "keywords": ["cryptohopper", "cryptohopper-ai", "mcp", "model-context-protocol", "vibe-coding", "claude", "cursor"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cryptohopper/cryptohopperai-mcp.git"
  },
  "homepage": "https://www.cryptohopper.ai",
  "bugs": "https://github.com/cryptohopper/cryptohopperai-mcp/issues",
  "engines": { "node": ">=20" },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25",
    "tsup": "^8",
    "typescript": "^6"
  }
}
